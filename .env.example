# .env.example raiz del monorepo — copia a .env y ajusta.
# Usado por compose.yml (servicio backend). No commitear el .env real.

# Django Configuration
SECRET_KEY=your-secret-key-here
# DJANGO_ALLOWED_HOSTS=deepbde.ginodilabio.com,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=True
# DeepBDE Model Configuration (ruta relativa a /app dentro del contenedor)
MODEL_PATH=deepbde/model_data/model
# Redis Configuration (en compose el host es "redis"; para runserver local usa localhost)
REDIS_URL=redis://redis:6379/0
# API Rate Limiting
RATE_LIMIT=10/m
# Base URL que ve el frontend (dev: http://localhost:8000; prod: mismo origen via nginx)
API_BASE_URL=http://localhost:8000
# SonarQube local (usado por scripts/sonar_scan.sh; el token NO va aqui)
SONAR_HOST_URL=http://localhost:9000
# Database Configuration (opcional si usas PostgreSQL en producción)
# DATABASE_URL=postgresql://user:password@localhost:5432/deepbde_db
# Email Configuration (opcional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=your-app-password
# Logging Level (opcional)
# LOG_LEVEL=INFO
# CORS Configuration (si necesitas CORS)
# CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200
# CSRF_TRUSTED_ORIGINS=https://deepbde.ginodilabio.com
# CORS_ALLOWED_ORIGINS=https://deepbde.ginodilabio.com
