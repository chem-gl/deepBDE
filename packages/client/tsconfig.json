/* tsconfig del cliente generado. `composite: true` permite references desde el tsconfig raiz. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "preserve",
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
